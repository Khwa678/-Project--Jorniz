# Copy to backend/.env and fill real values there.
# Do not commit real credentials.

# ─── Environment mode
ENVIRONMENT=development
FLASK_ENV=development

# ─── Security
# Generate with: python3 - <<'PY' then print(secrets.token_urlsafe(64))
SECRET_KEY=replace_with_a_strong_random_value

# ─── Backend URL / CORS
# Add your frontend origins exactly (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database
# 1) Leave empty for local sqlite (backend/healthy_universe.db fallback)
# 2) For Postgres use your provider connection string here.
DATABASE_URL=

# ─── Admin identities (comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ─── Vercel Blob (public post images/videos)
# Create a Public Blob store. Keep the read/write token server-side only.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# ─── Supabase Storage (optional, used by remaining non-post upload routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=media

# ─── EmailJS (optional, for OTP / password reset emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# ─── Auth/session behavior
TOKEN_EXPIRE_DAYS=1
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5

# ─── Ads & reward economics
COIN_REWARD_PER_IMPRESSION=1
COIN_REWARD_PER_CLICK=5
COST_PER_IMPRESSION=0.01
